# Supabase — 複製成 .env 後填入你自己的專案值。
# 真正的 .env 已被 .gitignore 忽略，不要 commit 進來。

# --- 瀏覽器端：Vite 在 build 時替換，會進到前端 bundle ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- 伺服器端：SSR 時的 fallback，見 src/integrations/supabase/client.ts ---
# 值與上面三個相同，本機開發兩組都填比較保險。
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- 選用，跑起這個專案不需要 ---
# src/integrations/supabase/client.server.ts 的 admin client 目前沒有任何地方 import。
# service_role key 會繞過所有 RLS，只能留在伺服器端，永遠不要進前端 bundle 或版控。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
